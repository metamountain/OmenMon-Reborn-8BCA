<OmenMon>
    <!--
      //\\   OmenMon: Hardware Monitoring & Control Utility
     //  \\  Configuration Settings XML File
         //  https://omenmon.github.io/
    -->
    <!-- Note: comments under child nodes such as <ColorPresets> and <FanPrograms>
         will be overwritten when the file is automatically generated upon save -->
    <Config>
        <!-- Automatically apply settings on start -->
        <AutoConfig>true</AutoConfig>
        <!-- Automatically start up with Windows -->
        <AutoStartup>true</AutoStartup>
        <!-- Ignore BIOS errors if false (for not fully compatible devices) -->
        <BiosErrorReporting>true</BiosErrorReporting>
        <!-- Pause BIOS heartbeat while on battery to prevent forced hibernation (default: true) -->
        <BiosHeartbeatPauseOnBattery>true</BiosHeartbeatPauseOnBattery>
        <!-- AC-flicker debounce: suppress brief AC->battery->AC transitions before
             switching fan programs or toggling the BIOS heartbeat (issue #70).
             AcFlickerGuard=false or AcFlickerHoldMs=0 restores the immediate-switch
             behaviour from earlier builds. Default hold = 10000 ms.
             AcFlickerConfirmSamples / AcFlickerConfirmIntervalMs add a multi-sample
             check at the end of the hold window: the deferred handler reads the live
             AC state N times and only acts if every read agrees, otherwise it
             re-defers (capped at AcFlickerMaxDeferralMs total). Samples are taken on
             the GUI timer tick (~1 s), so AcFlickerConfirmIntervalMs is a lower bound
             quantized up to that cadence Ã¢â‚¬â€ values below ~1 s yield one sample/tick.
             AcFlickerPassivePoll synthesises a deferred change from the timer tick
             when PowerLineStatus diverges from Op.FullPower without a
             PowerModeChanged event (Windows occasionally drops these). -->
        <AcFlickerGuard>true</AcFlickerGuard>
        <AcFlickerHoldMs>10000</AcFlickerHoldMs>
        <AcFlickerConfirmSamples>3</AcFlickerConfirmSamples>
        <AcFlickerConfirmIntervalMs>250</AcFlickerConfirmIntervalMs>
        <AcFlickerMaxDeferralMs>60000</AcFlickerMaxDeferralMs>
        <AcFlickerPassivePoll>true</AcFlickerPassivePoll>
        <!-- Battery-glitch guard (issue #59): some HP Omen / Victus SKUs report a
             sudden implausible battery-percentage drop (e.g. 100% -> 2%) while on AC
             under load, which can trigger Windows' Critical Battery hibernate. When a
             drop of >= BatteryGlitchDropPercent within BatteryGlitchWindowMs is seen
             on AC, OmenMon asserts ES_SYSTEM_REQUIRED to suppress hibernate for
             BatteryGlitchHoldMs. BatteryGlitchGuardOnBattery also runs the guard on
             battery; BatteryGlitchGuardDisableTimeout removes the 60 s safety release
             for sustained drops; BatteryGlitchGuardHoldAlways permanently holds the
             wake-lock while OmenMon runs (independent switch Ã¢â‚¬â€ works even with
             BatteryGlitchGuard=false). -->
        <BatteryGlitchGuard>true</BatteryGlitchGuard>
        <BatteryGlitchDropPercent>30</BatteryGlitchDropPercent>
        <BatteryGlitchWindowMs>5000</BatteryGlitchWindowMs>
        <BatteryGlitchHoldMs>30000</BatteryGlitchHoldMs>
        <BatteryGlitchGuardOnBattery>false</BatteryGlitchGuardOnBattery>
        <BatteryGlitchGuardDisableTimeout>false</BatteryGlitchGuardDisableTimeout>
        <BatteryGlitchGuardHoldAlways>false</BatteryGlitchGuardHoldAlways>
        <!-- Keep the system awake while the display is off via Graphics -> Set
             Display Off (issue #103): on Modern Standby laptops Windows treats
             "display off" as the sleep trigger, so without this the action puts
             the whole machine to sleep. Released on the first user input.
             Set to false to restore the previous bare display-off behaviour. -->
        <DisplayOffKeepAwake>true</DisplayOffKeepAwake>
        <!-- Display temperatures in Fahrenheit instead of Celsius (default: false) -->
        <TemperatureUseFahrenheit>false</TemperatureUseFahrenheit>
        <!-- Thermal Panic Mode: force max fans + balloon alert when temperature threshold is reached -->
        <!-- REQUIRES GuiDynamicIcon=true. Set to true only after verifying your sensors report realistic values. -->
        <ThermalPanicEnabled>false</ThermalPanicEnabled>
        <ThermalPanicTemperature>90</ThermalPanicTemperature>
        <ThermalPanicHysteresis>5</ThermalPanicHysteresis>
        <!-- Color Backlight -->
        <!-- Note: two default entries are hard-coded in the application
             and will appear if there is nothing else to show instead -->
        <ColorPresets>
            <Preset Name="All Amber">FF8800:FF8800:FF8800:FF8800</Preset>
            <Preset Name="All White">FFFFFF:FFFFFF:FFFFFF:FFFFFF</Preset>
            <Preset Name="Blue">005C36:005C36:005C36:005C36</Preset>
            <Preset Name="Cyan Magenta Yellow">FFFF00:FF0080:3AE5E7:FFFF00</Preset>
            <Preset Name="DefaultApp">0080FF:00FF00:00FF00:FFFFFF</Preset>
