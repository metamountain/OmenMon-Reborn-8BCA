            <!-- 8BCA: HP OMEN 16-xf0079ng (AMD Ryzen 7 7840HS, BIOS F.31/F.32) — THIS machine. -->
            <!--                                                                                              -->
            <!-- Every value below is the canonical default preset. The entry exists so the board reads as    -->
            <!-- KNOWN: Config.Models.ContainsKey() is what GuiFormMain.CheckUnknownModel() tests, and        -->
            <!-- without an entry the heuristic auto-detect prompt fires on every launch — an offer that must  -->
            <!-- always be declined here, because auto-calibration produces confidently wrong mappings on this -->
            <!-- board (hence AutoCal.Load() returning false). Presence is the whole point of this block.      -->
            <!--                                                                                              -->
            <!-- It previously carried ModeReg 89 (0x59), taken from Linux's omen_v1_thermal_params — its      -->
            <!-- DisplayName even said "OMEN v1 thermal profile at EC 0x59". That register reads a constant 0  -->
            <!-- on this firmware. It is 149 (0x95, HPCM) here, matching the default preset and every other    -->
            <!-- entry above. The Linux reports describe Linux; see CLAUDE.md "Disproven".                     -->
            <!--                                                                                              -->
            <!-- The fan level/rate/speed registers are inert on this board and are listed only to match the   -->
            <!-- default: 0x34/0x35 and 0x2E/0x2F hold firmware string data, and 0xB0/0xB2 is not a            -->
            <!-- tachometer (reads 0x005C/0x0000, never tracks load). Fan control goes over WMI                -->
            <!-- (FanLevelUseEc=false) and rpm comes from AutoCal's BiosLevelMirror, which needs no register.  -->
            <!-- Only CountdownReg 0x63, ManualReg 0x62 and SwitchReg 0xF4 are actually used from here.        -->
            <Model ProductId="8BCA" DisplayName="HP OMEN 16-xf0079ng (8BCA) - canonical regs, WMI fan control">
                <FanLevelReg0>52</FanLevelReg0>
                <FanLevelReg1>53</FanLevelReg1>
                <FanRateReadReg0>46</FanRateReadReg0>
                <FanRateReadReg1>47</FanRateReadReg1>
                <FanRateWriteReg0>44</FanRateWriteReg0>
                <FanRateWriteReg1>45</FanRateWriteReg1>
                <FanSpeedReg0>176</FanSpeedReg0>
                <FanSpeedReg1>178</FanSpeedReg1>
                <CountdownReg>99</CountdownReg>
                <ManualReg>98</ManualReg>
                <ModeReg>149</ModeReg>
                <SwitchReg>244</SwitchReg>
            </Model>
